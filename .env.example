APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# Development-only defaults. Replace every secret/password before using APP_ENV=production.
DATABASE_URL=postgresql+psycopg://knowbound:change-me@postgres:5432/knowbound
POSTGRES_DB=knowbound
POSTGRES_USER=knowbound
POSTGRES_PASSWORD=change-me
AUTH_TOKEN_SECRET=development-only-token-secret
BOOTSTRAP_TEACHER_USERNAME=teacher
BOOTSTRAP_TEACHER_PASSWORD=teacher-change-me
BOOTSTRAP_STUDENT_USERNAME=student
BOOTSTRAP_STUDENT_PASSWORD=student-change-me

MODEL_PROVIDER=mock
MODEL_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
MODEL_TIMEOUT_SECONDS=30
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.75
RUNNER_ENDPOINT=http://runner-controller:8080
RUNNER_TIMEOUT_SECONDS=5
RUNNER_SANDBOX_IMAGE=knowbound-cj-runner-sandbox:1.2.0
DOCKER_GID=0
